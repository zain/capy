# Copy to wrangler.toml before deploying your own installation.
name = "my-capy"
main = "worker.ts"
compatibility_flags = ["nodejs_compat"]
compatibility_date = "2026-09-01"
workers_dev = true

[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "none"
run_worker_first = true

[vars]
# Replace with your actual Worker URL or custom domain.
SITE_URL = "https://your-capy.example.com"
POSTHOG_TOKEN = ""

# On your Convex deployment set SITE_URL, BETTER_AUTH_SECRET,
# and CAPY_SELF_HOSTED=true. No Stripe secrets are needed.
